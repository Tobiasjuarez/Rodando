<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup de Android 12 en adelante. Se copian los viajes (Room) y las fotos, así un viaje
    sin enviar no se pierde al cambiar de teléfono. La sesión (token) no se copia: en el
    teléfono nuevo hay que volver a iniciar sesión.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/sesion.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/sesion.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
